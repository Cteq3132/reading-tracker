// Configuration Supabase du client iOS (voir docs/CONTRAT.md).
//
// Les valeurs réelles ne sont pas versionnées : copier Secrets.example.xcconfig
// en Secrets.xcconfig (ignoré par git) et le remplir. En CI, Secrets.xcconfig
// est généré depuis les secrets du dépôt.
//
// La clé publishable est faite pour être embarquée dans l'app : elle ne donne
// que les droits accordés par la RLS. Aucune clé secrète ne doit figurer ici.
// L'hôte est séparé du schéma car « // » ouvre un commentaire dans un .xcconfig.
SUPABASE_HOST =
SUPABASE_PUBLISHABLE_KEY =

#include? "Secrets.xcconfig"
